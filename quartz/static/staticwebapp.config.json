{
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": ["/static/*", "/*.{css,js,ico,webp,png,jpg,jpeg,gif,svg,xml,json,woff,woff2,ttf}"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".webp": "image/webp",
    ".woff2": "font/woff2"
  },
  "routes": [
    {
      "route": "/static/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  }
}
